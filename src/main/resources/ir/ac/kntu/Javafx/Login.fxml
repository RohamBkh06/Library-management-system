<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ir.ac.kntu.Javafx.LoginController"
      alignment="CENTER"
      spacing="15">


    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Login"
           style="-fx-font-size: 24px;"/>

    <Button text="Login as User"
            onAction="#handleUserLogin"
            prefWidth="250"
            prefHeight="40"/>

    <Button text="Login as Supporter"
            onAction="#handleSupporterLogin"
            prefWidth="250"
            prefHeight="40"/>

    <Button text="Login as Admin"
            onAction="#handleAdminLogin"
            prefWidth="250"
            prefHeight="40"/>

    <Button text="Back"
            onAction="#handleBack"
            prefWidth="250"
            prefHeight="40"/>


</VBox>
