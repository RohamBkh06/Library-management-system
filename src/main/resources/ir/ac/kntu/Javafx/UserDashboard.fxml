<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ir.ac.kntu.Javafx.UserDashboardController"
      spacing="15"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <!-- User Information -->

    <Label text="User Dashboard"
           style="-fx-font-size: 24px;"/>

    <VBox spacing="5"
          alignment="CENTER">

        <Label fx:id="welcomeLabel"
               style="-fx-font-size: 20px;"/>

        <Label fx:id="idLabel"/>

        <Label fx:id="emailLabel"/>

        <Label fx:id="phoneLabel"/>

        <Label fx:id="statusLabel"/>

        <Label fx:id="capacityLabel"/>

    </VBox>


    <!-- Main Options -->

    <HBox spacing="10"
          alignment="CENTER">

        <Button text="Browse Library"
                onAction="#handleBrowseLibrary"
                prefWidth="150"/>

        <Button text="Wallet"
                onAction="#handleWallet"
                prefWidth="150"/>

    </HBox>


    <HBox spacing="10"
          alignment="CENTER">

        <Button text="Borrowed Items"
                onAction="#handleBorrowedItems"
                prefWidth="150"/>

        <Button text="Reservations"
                onAction="#handleReservations"
                prefWidth="150"/>

        <Button text="Fines"
                onAction="#handleFines"
                prefWidth="150"/>

    </HBox>


    <HBox spacing="10"
          alignment="CENTER">

        <Button text="Settings"
                onAction="#handleSettings"
                prefWidth="150"/>

        <Button text="Support"
                onAction="#handleSupport"
                prefWidth="150"/>

        <Button text="Support Tickets"
                onAction="#handleSupportTickets"
                prefWidth="150"/>

    </HBox>


    <Button text="Logout"
            onAction="#handleLogout"
            prefWidth="200"/>

</VBox>
