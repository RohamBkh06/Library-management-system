<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ir.ac.kntu.Javafx.SystemSettingsController"
      spacing="20"
      style="-fx-padding: 25;">

    <Label text="System Properties"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;"/>


    <Label text="Configure library system settings"
           style="-fx-font-size: 15px;"/>


    <GridPane hgap="15"
              vgap="15">

        <padding>
            <Insets top="10"
                    right="10"
                    bottom="10"
                    left="10"/>
        </padding>


        <!-- Borrow Time -->

        <Label text="Borrow Time (Days):"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="borrowTimeField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>


        <!-- Reserve Limit -->

        <Label text="Reserve Limit:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="reserveLimitField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>


        <!-- Reserve Expire Days -->

        <Label text="Reserve Expire Days:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="reserveExpireDaysField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <!-- Base Fine -->

        <Label text="Base Fine:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="baseFineField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>


        <!-- Daily Fine -->

        <Label text="Daily Fine:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="dailyFineField"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

    </GridPane>


    <!-- Buttons -->

    <HBox spacing="10">

        <Button text="Update Borrow Time"
                onAction="#handleUpdateBorrowTime"/>

        <Button text="Update Reserve Limit"
                onAction="#handleUpdateReserveLimit"/>

        <Button text="Update Reserve Expire Days"
                onAction="#handleUpdateReserveExpireDays"/>

    </HBox>


    <HBox spacing="10">

        <Button text="Update Base Fine"
                onAction="#handleUpdateBaseFine"/>

        <Button text="Update Daily Fine"
                onAction="#handleUpdateDailyFine"/>

    </HBox>


    <HBox spacing="10">

        <Button text="Back"
                onAction="#handleBack"/>

    </HBox>

</VBox>

