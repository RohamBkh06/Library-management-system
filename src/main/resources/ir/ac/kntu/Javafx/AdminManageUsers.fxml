<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.ListView?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ir.ac.kntu.Javafx.AdminManageUsersController">

    
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Manage Users"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label fx:id="adminLabel"
                   text="Admin"/>

            <HBox spacing="10">

                <ComboBox fx:id="searchTypeComboBox"
                          prefWidth="150"/>

                <TextField fx:id="searchField"
                           promptText="Enter search value"
                           prefWidth="250"/>

                <Button text="Search"
                        onAction="#handleSearch"/>

                <Button text="Show All"
                        onAction="#handleShowAll"/>

            </HBox>

        </VBox>
    </top>


    <center>
        <VBox spacing="10">

            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Label text="Users"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ListView fx:id="usersListView"
                      VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>


    <bottom>
        <VBox spacing="10">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER">

                <Button fx:id="previousButton"
                        text="Previous"
                        onAction="#handlePreviousPage"/>

                <Label fx:id="pageLabel"
                       text="Page 1 / 1"/>

                <Button fx:id="nextButton"
                        text="Next"
                        onAction="#handleNextPage"/>

            </HBox>


            <HBox spacing="10"
                  alignment="CENTER">

                <Button text="Edit User"
                        onAction="#handleEditUser"/>

                <Button text="Remove User"
                        onAction="#handleRemoveUser"/>

                <Button text="Back"
                        onAction="#handleBack"/>

            </HBox>

        </VBox>
    </bottom>


</BorderPane>
