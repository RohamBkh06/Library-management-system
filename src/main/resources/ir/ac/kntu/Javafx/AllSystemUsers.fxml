<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ir.ac.kntu.Javafx.AllSystemUsersController">

    <top>
        <VBox spacing="10"
              style="-fx-padding: 20;">

            <Label text="All System Users"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label fx:id="pageLabel"
                   text="Page 1 / 1"
                   style="-fx-font-size: 14px;"/>

        </VBox>
    </top>


    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>


            <ListView fx:id="usersListView"
                      VBox.vgrow="ALWAYS"/>


            <HBox spacing="10">

                <Button fx:id="previousButton"
                        text="Previous"
                        onAction="#handlePrevious"/>

                <Button fx:id="nextButton"
                        text="Next"
                        onAction="#handleNext"/>

            </HBox>


            <Label text="Search"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;"/>


            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Enter search value"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search by First Name"
                        onAction="#handleSearchFirstName"/>

                <Button text="Search by Last Name"
                        onAction="#handleSearchLastName"/>

                <Button text="Search by Password"
                        onAction="#handleSearchPassword"/>

                <Button text="Clear Search"
                        onAction="#handleClearSearch"/>

            </HBox>


            <HBox spacing="10">

                <Button text="Back"
                        onAction="#handleBack"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>